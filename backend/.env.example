# Copie para backend/.env e ajuste (mesmos dados do DBeaver)

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sig_heartbeat_hub

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sig_heartbeat_hub

PORT=3000
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://[::1]:8080
JWT_SECRET=alterar-em-desenvolvimento

# Leituras em public.* trazem sempre todos os registos.
# DATA_SCOPE controla só UPDATE/DELETE:
#   all = altera qualquer registo por id
#   org = só registo da org do perfil
# INSERT continua a gravar org_id do perfil.
DATA_SCOPE=all

# Copie para backend/.env e ajuste (mesmos dados do DBeaver)

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sig_gestao_ti

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sig_gestao_ti

PORT=3000
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://[::1]:8080
JWT_SECRET=alterar-em-desenvolvimento

# O modo padrão agora é org para evitar atualizações/exclusões globais por id.
# Em desenvolvimento, altere para all apenas se necessário.
DATA_SCOPE=org

# Leituras em public.* filtram por org_id quando DATA_SCOPE=org.
# UPDATE/DELETE também respeitam o mesmo escopo.

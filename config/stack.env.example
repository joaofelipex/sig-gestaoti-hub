# Stack SIG — copie para config/stack.env os dados do DBeaver (host, porta, user, senha, base).
# Não precisa de Docker: use o Postgres que já tem.
#   npm run stack:bootstrap   # sobe DB + schema + seed demo (uma vez ou se vazio)
#   npm run dev:stack         # API + UI
#
# A API lê SEMPRE esta base via DATABASE_URL (gerado em backend/.env).
# Os dados persistem no volume Docker até `npm run db:reset`.

STACK=local

# --- Ligação PostgreSQL (escolha UMA forma) ---

# Recomendado: URI completa do seu servidor
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DA_BASE

# Ou campos separados (usados se DATABASE_URL estiver vazio):
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sig_heartbeat_hub

# Porta no host (Docker deste repo: npm run db:up → 5433)
HOST_PG_PORT=5433

# Porta HTTP da API
API_PORT=3000

# Browser → API (proxy do ng serve encaminha /api → API_PORT)
PUBLIC_API_URL=/api

CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://[::1]:8080

JWT_SECRET=alterar-em-desenvolvimento

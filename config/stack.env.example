# Stack do SIG Heartbeat Hub — copie para `config/stack.env` e ajuste.
# (`config/stack.env` está no .gitignore; este ficheiro é o modelo partilhado.)
#
# Depois de editar:  npm run sync:stack
# Isto regista a mesma configuração no backend (.env), no Angular (environment.stack.ts)
# e no proxy do Vite (proxy.conf.json).

# Perfil lógico (ex.: local, staging) — controla dicas de UI em desenvolvimento
STACK=local

# Porta Postgres no host (tem de bater com `scripts/db.sh` / contentor)
HOST_PG_PORT=5433

# Credenciais e base usadas pela API Node (`pg`)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sig_heartbeat_hub

# Se definir, sobrepõe DB_* acima
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sig_heartbeat_hub

# Porta HTTP da API Express
API_PORT=3000

# URL da API no browser: `/api` (recomendado com proxy do `ng serve`) ou URL absoluta
PUBLIC_API_URL=/api

# CORS na API. Use * só em desenvolvimento (aceita qualquer origem).
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080,http://[::1]:8080

JWT_SECRET=alterar-em-desenvolvimento

# Copia dados de um Postgres remoto para o Postgres local (Docker).
# Copia este ficheiro para `.env` na raiz e preenche a URI (não fazer commit do `.env`).

# --- Importar CSV ---
# DATABASE_URL="postgresql://USER:SENHA@127.0.0.1:5433/sig_gestao_ti"
# CSV_DIR="C:/Users/.../Downloads"
# npm run db:import-csv
# (O script deteta AUTH_MODE: full com auth.identities, ou auth.users minimal no Docker.)

# URI do Postgres remoto (sslmode=require se for na nuvem)
REMOTE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/NOME_BD?sslmode=require"

# Opcional: Postgres Docker local (scripts/sync-remote-to-docker.sh)
# LOCAL_POSTGRES_PASSWORD=postgres
# HOST_PG_PORT=5433
